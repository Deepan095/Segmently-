# ===========================================================================
# Segmently - PRODUCTION environment. Copy to deploy/.env.prod and fill in.
#   cp deploy/.env.prod.example deploy/.env.prod
# Never commit deploy/.env.prod.
# ===========================================================================

# --- Domains / TLS ---
SITE_DOMAIN=segmently.online
S3_DOMAIN=s3.segmently.online
ACME_EMAIL=you@example.com            # Let's Encrypt notifications

# --- App ---
APP_NAME=Segmently
DEBUG=false                            # MUST be false in production

# --- Auth (generate: openssl rand -hex 32) ---
SECRET_KEY=CHANGE_ME_openssl_rand_hex_32
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Seed admin (created once by `scripts.seed`) ---
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=CHANGE_ME_strong_password

# --- Database (choose a strong password; used in two places) ---
POSTGRES_USER=segmently
POSTGRES_PASSWORD=CHANGE_ME_db_password
POSTGRES_DB=segmently
DATABASE_URL=postgresql://segmently:CHANGE_ME_db_password@db:5432/segmently

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Object storage (MinIO on this VPS) ---
STORAGE_ENDPOINT_URL=http://minio:9000              # internal - do not change
STORAGE_PUBLIC_ENDPOINT_URL=https://s3.segmently.online   # signs browser URLs
STORAGE_BUCKET=segmently-media
STORAGE_ACCESS_KEY=CHANGE_ME_minio_access_key
STORAGE_SECRET_KEY=CHANGE_ME_minio_secret_key
STORAGE_FORCE_PATH_STYLE=true

# --- Google OAuth (optional; leave blank to disable the button) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://segmently.online/api/v1/auth/google/callback

# --- Frontend / CORS ---
FRONTEND_URL=https://segmently.online
ALLOWED_ORIGINS=["https://segmently.online","https://www.segmently.online"]
# Baked into the web build - the browser calls the API at this origin.
VITE_API_URL=https://segmently.online

# --- AI pipeline ---
TRANSCRIPTION_BACKEND=openai
WHISPER_MODEL=base
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini

# --- B-roll (optional) ---
BROLL_ENABLED=true
PEXELS_API_KEY=

# --- Media limits / tuning ---
MAX_UPLOAD_BYTES=5368709120            # 5 GiB
MAX_SOURCE_DURATION_SECONDS=14400      # 4 h
YTDLP_MAX_HEIGHT=720
RENDER_MODE=fit
FFMPEG_PRESET=superfast
SEGMENTS_TARGET=6
SEGMENTS_MAX=10
WORKER_CPUS=2                          # cap the render worker's CPU
