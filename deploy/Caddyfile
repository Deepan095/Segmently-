# Segmently reverse proxy + automatic HTTPS (Let's Encrypt).
# Domains and email come from the compose environment.

{
	email {$ACME_EMAIL}
}

# --- www -> apex -----------------------------------------------------------
www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}

# --- App: SPA + API on the apex domain ------------------------------------
{$SITE_DOMAIN} {
	encode zstd gzip

	# Large uploads pass through the proxy.
	request_body {
		max_size 6GB
	}

	# API, auth, health, docs -> FastAPI.
	@api path /api/* /health /docs /openapi.json
	handle @api {
		reverse_proxy api:8000
	}

	# Everything else -> the static SPA (nginx in the web container, :8080).
	handle {
		reverse_proxy web:8080
	}
}

# --- Media: S3 (MinIO) on its own subdomain ------------------------------
# Presigned clip URLs are signed for this host; reverse_proxy forwards the
# Host header unchanged so MinIO's SigV4 check still passes.
{$S3_DOMAIN} {
	encode gzip
	request_body {
		max_size 6GB
	}
	reverse_proxy minio:9000
}
