# ===========================================================================
# Segmently - environment configuration
# Copy to .env and adjust.  Defaults below target the docker-compose stack.
#   cp .env.example .env
# ===========================================================================

# --- App ---
APP_NAME=Segmently
# Local/dev default. Set DEBUG=false in production - the API then refuses to
# boot while SECRET_KEY / ADMIN_PASSWORD / the DB password are still defaults.
DEBUG=true

# --- Database ---
# Host name "db" is the postgres service inside the compose network.
DATABASE_URL=postgresql://segmently:segmently@db:5432/segmently
POSTGRES_USER=segmently
POSTGRES_PASSWORD=segmently
POSTGRES_DB=segmently

# --- Auth ---
SECRET_KEY=dev-secret-change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Seed admin (created by `python -m scripts.seed`) ---
ADMIN_EMAIL=admin@segmently.dev
ADMIN_PASSWORD=dev-admin-change-me

# --- Google OAuth ---
GOOGLE_CLIENT_ID=your-client-id
GOOGLE_CLIENT_SECRET=your-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# --- Object storage (S3-compatible / MinIO in dev) ---
# Host name "minio" is the MinIO service inside the compose network.
STORAGE_ENDPOINT_URL=http://minio:9000
# Browser-facing MinIO/S3 host used to sign clip preview + download URLs.
# In the compose stack the API reaches MinIO at "minio:9000" but the browser
# needs "localhost:9000". For real S3, leave blank.
STORAGE_PUBLIC_ENDPOINT_URL=http://localhost:9000
STORAGE_BUCKET=segmently-media
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin

# --- Worker / queue ---
# Host name "redis" is the redis service inside the compose network.
REDIS_URL=redis://redis:6379/0

# --- AI pipeline ---
# Transcription backend:
#   local  = faster-whisper on the worker CPU. No API cost, slower (~0.5-1x
#            realtime for the "base" model; a 10-min video ~ 5-15 min).
#   openai = OpenAI audio API. Fast, ~$0.006/min, needs OPENAI_API_KEY.
TRANSCRIPTION_BACKEND=local
WHISPER_MODEL=base            # tiny | base | small | medium | large-v3  (local only)
# WHISPER_DEVICE=cuda         # uncomment if the worker host has an NVIDIA GPU
# WHISPER_COMPUTE_TYPE=float16

# Segment detection + (optional) transcription use the OpenAI API.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini      # chat model for moment selection

# --- B-roll (auto stock-footage cutaways over the talking head) ---
# Opt-in: needs a free Pexels API key (https://www.pexels.com/api/).
BROLL_ENABLED=false
PEXELS_API_KEY=

# --- Frontend ---
# Browser-facing URL of the API (baked into the web build at build time).
VITE_API_URL=http://localhost:8000
